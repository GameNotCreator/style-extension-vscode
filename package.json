    "walkthroughs": [
      {
        "id": "viraLocal.getStarted",
        "title": "Welcome to your new coding experience with Vira Local.",
        "description": "A visual system for focus, tuned for long sessions in dark environments.",
        "steps": [
          {
            "id": "variants",
            "title": "Choose a color theme",
            "description": "Pick among 10 color variants (and high-contrast options) for your coding experience.\n\n[Pick a color theme](command:viraLocal.openColorThemePicker)",
            "media": {
              "image": "media/walkthrough/variants.png",
              "altText": "Illustration of switching Vira color theme variants"
            },
            "completionEvents": [
              "onCommand:viraLocal.openColorThemePicker",
              "onSettingChanged:workbench.colorTheme"
            ]
          },
          {
            "id": "accent",
            "title": "Set your accent",
            "description": "Accents make it personal. Choose a named accent that fits your theme or set a custom color — then optionally [adjust intensity](command:viraLocal.accentIntensityPicker).\n\n[Set the accent color](command:viraLocal.accentPicker)",
            "media": {
              "image": "media/walkthrough/accents.png",
              "altText": "Illustration of Vira accent color choices"
            },
            "completionEvents": [
              "onCommand:viraLocal.accentPicker",
              "onCommand:viraLocal.accentIntensityPicker",
              "onSettingChanged:viraLocal.accent",
              "onSettingChanged:viraLocal.accentIntensity"
            ]
          },
          {
            "id": "icon-style",
            "title": "Icons style",
            "description": "Choose the appearance of the UI icons between solid or outlined. Open the setting and switch `Use Outlined Icons` to try both styles.\n\n[Change icons style](command:viraLocal.openOutlinedIconsSetting)",
            "media": {
              "image": "media/walkthrough/icons-style.png",
              "altText": "Illustration of filled versus outlined folder icons"
            },
            "completionEvents": [
              "onCommand:viraLocal.openOutlinedIconsSetting",
              "onSettingChanged:viraLocal.useOutlinedIcons"
            ]
          },
          {
            "id": "explore-more",
            "title": "Explore more settings",
            "description": "Borders, shadows, tab contrast, italics, and more live in Vira Local settings — open them anytime from the Command Palette.\n\n[Explore more settings](command:viraLocal.openSettings)",
            "media": {
              "image": "media/walkthrough/explore-more.png",
              "altText": "Illustration pointing to extension settings"
            },
            "completionEvents": [
              "onCommand:viraLocal.openSettings"
            ]
          }
        ]
      }
