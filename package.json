{
  "name": "vira-local",
  "displayName": "Vira Local",
  "publisher": "hedi-local",
  "version": "1.0.0",
  "private": true,
  "description": "Thèmes et icônes Vira récupérés localement, avec commandes visuelles autonomes.",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Themes"
  ],
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "logo.png",
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "configuration": {
      "title": "Vira Local",
      "type": "object",
      "properties": {
        "viraLocal.accent": {
          "order": 1,
          "type": "string",
          "default": "Teal",
          "enum": [
            "Vira",
            "White",
            "Tomato",
            "Orange",
            "Yellow",
            "Acid Lime",
            "Lime",
            "Teal",
            "Bright Teal",
            "Cyan",
            "Blue",
            "Indigo",
            "Purple",
            "Pink"
          ],
          "description": "Set the accent color used across the interface and icons.",
          "scope": "window"
        },
        "viraLocal.customAccent": {
          "order": 2,
          "type": "string",
          "markdownDescription": "The custom accent **will override** the `#viraLocal.accent#` color. Run clear accent command or manually remove the value.",
          "scope": "window",
          "pattern": "^$|^#([A-Fa-f0-9]{6})$",
          "patternErrorMessage": "Invalid color format. Enter a valid 6 digits hex color."
        },
        "viraLocal.accentIntensity": {
          "order": 3,
          "type": "string",
          "default": "vivid",
          "enum": [
            "soft",
            "normal",
            "vivid"
          ],
          "enumDescriptions": [
            "Softer, less saturated built-in accent colors.",
            "Balanced built-in accent colors.",
            "More saturated built-in accent colors (default)."
          ],
          "description": "Adjust saturation of built-in accent colors across the interface and icons.",
          "scope": "window"
        },
        "viraLocal.useOutlinedIcons": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use outlined folder icons.",
          "scope": "window"
        },
        "viraLocal.folderAccentMode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Apply accent color to open/expanded explorer folder icons. When off, open folders keep named glyphs without accent tint.",
          "scope": "window"
        },
        "viraLocal.useTopTabIndicator": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Put the current tab indicator at the top instead of the bottom.",
          "scope": "window"
        },
        "viraLocal.syncThemesAndIcons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Synchronize file icons themes with UI themes when switching themes.",
          "scope": "window"
        },
        "viraLocal.syncProductIcons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Synchronize the product icon theme (Vira Solid / Vira Outline) with the outlined folder icons setting.",
          "scope": "window"
        },
        "viraLocal.showBorders": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Show borders in some area of the editor"
        },
        "viraLocal.contrastedTabs": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Add more contrast to tabs by using a different background for the tabs bar"
        },
        "viraLocal.solidLineHighlight": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Render a solid background highlight for the active line instead of a border"
        },
        "viraLocal.hidesExplorerArrows": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Hide arrow icons in the file explorer.",
          "scope": "window"
        },
        "viraLocal.hidesShadows": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Hide shadows across the interface for a completely flat look.",
          "scope": "window"
        },
        "viraLocal.disableItalics": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Disable italic font style for selected syntax scopes.",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "viraLocal.openSettings",
        "title": "Open Settings",
        "category": "Vira Local"
      },
      {
        "command": "viraLocal.openWalkthrough",
        "title": "Get Started",
        "category": "Vira Local"
      },
      {
        "command": "viraLocal.openColorThemePicker",
        "title": "Open Vira Local Color Theme Picker",
        "category": "Vira Local"
      },
      {
        "command": "viraLocal.openOutlinedIconsSetting",
        "title": "Open Outlined Icons Setting",
        "category": "Vira Local"
      },
      {
        "command": "viraLocal.accentPicker",
        "title": "Set Accent Color",
        "category": "Vira Local"
      },
      {
        "command": "viraLocal.accentIntensityPicker",
        "title": "Set Accent Intensity",
        "category": "Vira Local"
      }
    ],
    "themes": [
